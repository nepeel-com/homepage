{
  "name": "nepeel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "mobile"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "mobile": "npm run start --workspace mobile",
    "typecheck:mobile": "npm run typecheck --workspace mobile"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "cbor": "^10.0.12",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "node-app-attest": "1.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
