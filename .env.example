# Public web client. Supabase Dashboard > Project settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only. NEVER prefix these with VITE_ or EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IOS_BUNDLE_ID=com.nepeel.app
APPLE_TEAM_ID=
# production by default; development is ONLY for an isolated staging project.
APP_ATTEST_ENVIRONMENT=production
ANDROID_PACKAGE_NAME=com.nepeel.app
# Comma-separated BASE64URL SHA256 certificates, from Play app signing.
ANDROID_CERTIFICATE_SHA256=
# JSON service-account credential with access to Google Play Integrity.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional direct-install Android verification. Enable only with a tested server runtime.
ANDROID_HARDWARE_ATTESTATION_ENABLED=false
# Comma-separated HEX SHA256 APK signing certificate digests (not Play's base64url format).
ANDROID_HARDWARE_CERT_SHA256=
ANDROID_HARDWARE_MIN_VERSION=2
